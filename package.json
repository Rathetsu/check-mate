{
  "name": "checkmate",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "e2e": "pnpm --filter @checkmate/web e2e",
    "check:register": "node scripts/check-register.ts --check",
    "register:write": "node scripts/check-register.ts",
    "db:generate": "pnpm --filter @checkmate/core db:generate",
    "db:migrate": "pnpm --filter @checkmate/core db:migrate"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "eslint": "^10.12.0",
    "eslint-config-next": "^16.4.0",
    "prettier": "^3.9.10",
    "sharp": "0.35.5",
    "turbo": "^2.11.7",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
