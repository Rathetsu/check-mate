# Copy to .env (never committed). Local `pnpm dev` and the compose stack read it.

# Postgres. Local dev uses the compose service on 127.0.0.1:5432.
POSTGRES_PASSWORD=checkmate
DATABASE_URL=postgres://checkmate:checkmate@127.0.0.1:5432/checkmate

# Better Auth. Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Public hostname for Caddy: a domain, <server-ip>.sslip.io, or localhost.
SITE_ADDRESS=localhost

# Email (optional, 2026-10-11-03). Unset SMTP_HOST = links go to the server log.
# Local dev with Mailpit: SMTP_HOST=127.0.0.1 SMTP_PORT=1025 (UI on :8025).
# Full compose stack: SMTP_HOST=mailpit SMTP_PORT=1025 (containers can't reach 127.0.0.1).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=CheckMate <no-reply@example.com>
