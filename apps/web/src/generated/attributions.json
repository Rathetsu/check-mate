  "datasets": [
    {
      "name": "Lichess standard rated game dumps (database.lichess.org)",
      "terms": "CC0",
      "notes": "8.22B games. We ingest a sized subset"
    },
    {
      "name": "Lichess puzzle CSV",
      "terms": "CC0",
      "notes": "6,157,341 puzzles (2026-10-05). Attribution optional; given anyway"
    },
    {
      "name": "Lichess broadcast dumps",
      "terms": "CC BY-SA 4.0",
      "notes": "Attribution in UI. Share-alike is met by the monthly CC BY-SA masters dump on /about/data (P2-EI-35)"
    },
    {
      "name": "lichess-org/chess-openings",
      "terms": "CC0",
      "notes": "Commit a6189a30 (2026-10-06), replayed into packages/chess/src/data/openings.json by scripts/gen-openings.ts"
    },
    {
      "name": "Lichess game export + OAuth API",
      "terms": "Lichess ToS; one request at a time; wait ≥60 s after 429",
      "notes": "PKCE public client, no scopes; anonymous export is being throttled"
    },
    {
      "name": "Have I Been Pwned (Pwned Passwords range API)",
      "terms": "free, no key; k-anonymity (only a 5-character SHA-1 prefix is sent)",
      "notes": "Disclosed on /privacy"
    },
    {
      "name": "Test fixtures (packages/chess/fixtures/)",
      "terms": "per file: Lichess game exports CC0, broadcast round CC BY-SA 4.0, our own study and Chess.com games, synthetic malformed files",
      "notes": "Sources and licenses listed in the fixture README. No other players' Chess.com data"
    }
  ],
